%% Description: its plan for my home distribution box, 
%% preparing for myself, dont care about following standards. 
%% It has 4 DIN rails, and 1 sub-box with 1 DIN rail.
%% Cables from MCB to devices are already installed and cannot be changed.
%% Execution:
%% 1 step [done]  : draw my idea in mermaid js.  definition of done: when gemini AI can  fully understand what is written. no ambiguity, no extra explanation is needed, everything is clear from schema.
%% 2 step : review part - this is where electricity knowledge is needed. validate devices, load, cable thickness and so on. definition of done: plan is ready for real installation, i know how to connect everything and what devices to buy. 

subgraph Legend [Legend: Wire Types]
    direction LR
        Leg1[Line L]:::c_line ==>|10mm² / Busbar| Leg2[Phase]
        Leg3[Neutral N]:::c_neutral -->|Blue| Leg4[Neutral]
        Leg5[Earth PE]:::c_ground -.->|Green/Yellow| Leg6[Earth]
end

subgraph Rail_0 [Rail 0: Main Incoming]
    
    subgraph rail_0_I_devices  
        Incomer_L[3-Phase Supply]:::c_line
        Incomer_PE[Ground Bar]:::c_ground
        Incomer_N[Neutral Bar]:::c_neutral
    end

    subgraph rail_0_devices
        MB[Main Breaker 32A] ~~~ 
        SPD[SPD Noark Ex9UE1+2 12.5 3PN 275] ~~~ 
        MCB_kitchen_3P[MCB 3P C16: Oven/Hob<br/>Load: ~4000W+<br/>Cable: 5x2.5mm²]:::c_monitored_1pm ~~~ 
                                                                                   %% +1 c_monitored_1pm 
        Split_Point_0_L((" ")):::c_line     
    end
  
    %% Internal Distribution (Backbone)
    %% 6mm² is safe for 32A Main Breaker
    Incomer_L ==>|6mm²| MB
    MB ==>|6mm²| Split_Point_0_L  
    Split_Point_0_L ==>|6mm²| SPD
    Split_Point_0_L ==>|4mm²| MCB_kitchen_3P
    Incomer_N -->|6mm²| SPD
    Incomer_PE -.->|10mm²| SPD
end

subgraph Rail_1 [Rail 1: Phase L1]
    R1[RCCB 1: 40A] 
    
    subgraph rail_1_devices    
        Busbar_1[Comb Busbar L1]:::c_line ~~~
        MCB_vaiko_roz[MCB C16: Vaiko k. roz<br/>Load: 1000W<br/>Cable: 3x2.5mm²]:::c_monitored_mini ~~~
        MCB_vaiko_sv[MCB B6: Vaiko k. sv<br/>Load: 100W<br/>Cable: 3x1.5mm²] ~~~
        MCB_svetaine_sv[MCB B6: Svetaine sv<br/>Load: 150W<br/>Cable: 3x1.5mm²] ~~~
        MCB_miegamas_tv[MCB C6: Miegamas TV<br/>Load: 200W<br/>Cable: 3x2.5mm²] ~~~
        MCB_miegamas_sv[MCB B6: Miegamas sv<br/>Load: 100W<br/>Cable: 3x1.5mm²] ~~~
        MCB_drabuzine_roz[MCB C6: Miegamas & drabuzine<br/>Load: 100W<br/>Cable: 3x2.5mm²] ~~~
        MCB_svetaine_roz[MCB B16: Svetaine roz.<br/>Load: 800W<br/>Cable: 3x2.5mm²]:::c_monitored_mini 
    end
    
    N_Bar1[N-Bar Rail 1]:::c_neutral
    
    %% Connections    
    Split_Point_0_L ==>|6mm²| R1
    R1 ==>|6mm²| Busbar_1
    
    Busbar_1 ==> MCB_vaiko_roz
    Busbar_1 ==> MCB_vaiko_sv
    Busbar_1 ==> MCB_svetaine_sv
    Busbar_1 ==> MCB_miegamas_tv
    Busbar_1 ==> MCB_miegamas_sv
    Busbar_1 ==> MCB_drabuzine_roz
    Busbar_1 ==> MCB_svetaine_roz    
    
    Incomer_N -->|6mm²| R1    
    R1 -->|6mm²| N_Bar1    
end

subgraph Rail_1_sub [Sub-box Rail: L1 Extension]

    subgraph devices_sub
        Busbar_1_1[Comb Busbar L1-Sub]:::c_line ~~~
        MCB_skalbimo_roz[MCB C16: Washer/Dryer<br/>Load: 2000W<br/>Cable: 3x2.5mm²]:::c_monitored_mini ~~~    
        MCB_ev_skoda_roz[MCB C16: EV Skoda<br/>Load: 2500W<br/>Cable: 3x2.5mm²]:::c_monitored_mini ~~~
        MCB_rekup[MCB C6: Recuperation<br/>Load: 200W<br/>Cable: 3x2.5mm²]:::c_monitored_snf ~~~
        MCB_network[MCB C6: Network<br/>Load: 100W<br/>Cable: 3x2.5mm²]:::c_monitored_snf     
    end
    
    %% Feed to Sub-box
    %% 4mm² is safe for 21A load and acceptable for 32A protection
    Busbar_1 ==>|4mm² Cable| Busbar_1_1
    
    Busbar_1_1 ==> MCB_skalbimo_roz
    Busbar_1_1 ==> MCB_ev_skoda_roz
    Busbar_1_1 ==> MCB_rekup
    Busbar_1_1 ==> MCB_network
    
    N_Bar1 -->|4mm²| N_Bar1_1[N-Bar Rail 1-1]:::c_neutral
end

