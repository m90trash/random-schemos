%% Description: its plan for my home distribution box, 
%% preparing for myself, dont care about following standards. 
%% It has 4 DIN rails, and 1 sub-box with 1 DIN rail.
%% Cables from MCB to devices are already installed and cannot be changed.
%% Execution:
%% 1 step [done]  : draw my idea in mermaid js.  definition of done: when gemini AI can  fully understand what is written. no ambiguity, no extra explanation is needed, everything is clear from schema.
%% 2 step : review part - this is where electricity knowledge is needed. validate devices, load, cable thickness and so on. definition of done: plan is ready for real installation, i know how to connect everything and what devices to buy. 

subgraph Legend [Legend: Wire Types]
    direction LR
        Leg1[Line L] ==>|10mm² / Busbar| Leg2[Phase]
        Leg3[Neutral N] -->|Blue| Leg4[Neutral]
        Leg5[Earth PE] -.->|Green/Yellow| Leg6[Earth]
end

subgraph Rail_0  
    
    subgraph rail_0_I_devices  
        Incomer_L[3-Phase Supply]
        Incomer_PE[Ground Bar]
        Incomer_N[Neutral Bar]
    end

    subgraph rail_0_devices
        MB[Main Breaker 32A] ~~~ 
        SPD[SPD Type 2 4P] ~~~ 
        MCB_kitchen_3P[MCB 3P C16: Oven/Hob<br/>Load: ~4000W+<br/>Cable: 5x2.5mm²] 
        Split_Point_0_L((Distribution Block))
    end
  
    %% Internal Distribution
    Incomer_L ==>|10mm²| MB
    MB ==>|10mm²| Split_Point_0_L  
    Split_Point_0_L ==>|10mm²| SPD
    Split_Point_0_L ==>|4mm²| MCB_kitchen_3P
    Incomer_N -->|10mm²| SPD
    Incomer_PE -.->|10mm²| SPD
end

subgraph Rail_1 [Rail 1: Phase L1]
